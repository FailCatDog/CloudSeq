<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.guet.feishu.mapper.ProjectMapper">

    <resultMap id="BaseResultMap" type="cn.guet.feishu.entity.Project">
        <id column="id" property="id"/>
        <result column="project_id" property="projectId"/>
        <result column="project_name" property="projectName"/>
        <result column="project_code" property="projectCode"/>
        <result column="description" property="description"/>
        <result column="creator_id" property="creatorId"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="status" property="status"/>
        <result column="max_group_size" property="maxGroupSize"/>
        <result column="min_group_size" property="minGroupSize"/>
        <result column="group_deadline" property="groupDeadline"/>
        <result column="allow_student_create_group" property="allowStudentCreateGroup"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, project_id, project_name, project_code, description, creator_id,
        start_time, end_time, status, max_group_size, min_group_size,
        group_deadline, allow_student_create_group, create_time, update_time
    </sql>

    <select id="selectByProjectId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM project
        WHERE project_id = #{projectId}
    </select>

    <select id="selectByProjectCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM project
        WHERE project_code = #{projectCode}
    </select>

    <select id="selectByCreatorId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM project
        WHERE creator_id = #{creatorId}
        ORDER BY create_time DESC
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM project
        ORDER BY create_time DESC
    </select>

    <insert id="insert" parameterType="cn.guet.feishu.entity.Project">
        INSERT INTO project (
            project_id, project_name, project_code, description, creator_id,
            start_time, end_time, status, max_group_size, min_group_size,
            group_deadline, allow_student_create_group
        ) VALUES (
            #{projectId}, #{projectName}, #{projectCode}, #{description}, #{creatorId},
            #{startTime}, #{endTime}, #{status}, #{maxGroupSize}, #{minGroupSize},
            #{groupDeadline}, #{allowStudentCreateGroup}
        )
    </insert>

    <update id="updateByProjectId" parameterType="cn.guet.feishu.entity.Project">
        UPDATE project
        <set>
            <if test="projectName != null">project_name = #{projectName},</if>
            <if test="description != null">description = #{description},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="maxGroupSize != null">max_group_size = #{maxGroupSize},</if>
            <if test="minGroupSize != null">min_group_size = #{minGroupSize},</if>
            <if test="groupDeadline != null">group_deadline = #{groupDeadline},</if>
            <if test="allowStudentCreateGroup != null">allow_student_create_group = #{allowStudentCreateGroup},</if>
        </set>
        WHERE project_id = #{projectId}
    </update>

    <delete id="deleteByProjectId">
        DELETE FROM project WHERE project_id = #{projectId}
    </delete>

</mapper>

