<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.guet.feishu.mapper.GroupMemberMapper">

    <resultMap id="BaseResultMap" type="cn.guet.feishu.entity.GroupMember">
        <id column="id" property="id"/>
        <result column="group_member_id" property="groupMemberId"/>
        <result column="group_id" property="groupId"/>
        <result column="user_id" property="userId"/>
        <result column="role_in_group" property="roleInGroup"/>
        <result column="join_time" property="joinTime"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, group_member_id, group_id, user_id, role_in_group,
        join_time, status, create_time, update_time
    </sql>

    <select id="selectByGroupMemberId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM group_member
        WHERE group_member_id = #{groupMemberId}
    </select>

    <select id="selectByGroupIdAndUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM group_member
        WHERE group_id = #{groupId} AND user_id = #{userId}
    </select>

    <select id="selectByProjectIdAndUserId" resultMap="BaseResultMap">
        SELECT gm.*
        FROM group_member gm
        INNER JOIN project_group pg ON gm.group_id = pg.group_id
        WHERE pg.project_id = #{projectId} AND gm.user_id = #{userId} AND gm.status = 1
        LIMIT 1
    </select>

    <select id="selectByGroupId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM group_member
        WHERE group_id = #{groupId}
        ORDER BY join_time ASC
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM group_member
        WHERE user_id = #{userId}
        ORDER BY join_time DESC
    </select>

    <select id="countByGroupId" resultType="int">
        SELECT COUNT(*)
        FROM group_member
        WHERE group_id = #{groupId} AND status = 1
    </select>

    <insert id="insert" parameterType="cn.guet.feishu.entity.GroupMember">
        INSERT INTO group_member (
            group_member_id, group_id, user_id, role_in_group, status
        ) VALUES (
            #{groupMemberId}, #{groupId}, #{userId}, #{roleInGroup}, #{status}
        )
    </insert>

    <update id="updateByGroupMemberId" parameterType="cn.guet.feishu.entity.GroupMember">
        UPDATE group_member
        <set>
            <if test="roleInGroup != null">role_in_group = #{roleInGroup},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE group_member_id = #{groupMemberId}
    </update>

    <delete id="deleteByGroupMemberId">
        DELETE FROM group_member WHERE group_member_id = #{groupMemberId}
    </delete>

    <delete id="deleteByGroupId">
        DELETE FROM group_member WHERE group_id = #{groupId}
    </delete>

</mapper>

