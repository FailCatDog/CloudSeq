<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.guet.feishu.mapper.GroupDocumentMapper">

    <resultMap id="GroupDocumentResultMap" type="cn.guet.feishu.entity.GroupDocument">
        <id property="id" column="id"/>
        <result property="documentId" column="document_id"/>
        <result property="groupId" column="group_id"/>
        <result property="folderId" column="folder_id"/>
        <result property="documentName" column="document_name"/>
        <result property="fileType" column="file_type"/>
        <result property="fileSize" column="file_size"/>
        <result property="filePath" column="file_path"/>
        <result property="description" column="description"/>
        <result property="creatorId" column="creator_id"/>
        <result property="downloadCount" column="download_count"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <insert id="insert" parameterType="cn.guet.feishu.entity.GroupDocument">
        INSERT INTO group_document (document_id, group_id, folder_id, document_name, file_type, 
                                    file_size, file_path, description, creator_id, status)
        VALUES (#{documentId}, #{groupId}, #{folderId}, #{documentName}, #{fileType}, 
                #{fileSize}, #{filePath}, #{description}, #{creatorId}, #{status})
    </insert>

    <update id="update" parameterType="cn.guet.feishu.entity.GroupDocument">
        UPDATE group_document
        <set>
            <if test="documentName != null">document_name = #{documentName},</if>
            <if test="description != null">description = #{description},</if>
            <if test="folderId != null">folder_id = #{folderId},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE document_id = #{documentId}
    </update>

    <delete id="deleteById">
        DELETE FROM group_document WHERE document_id = #{documentId}
    </delete>

    <select id="findById" resultMap="GroupDocumentResultMap">
        SELECT * FROM group_document WHERE document_id = #{documentId}
    </select>

    <select id="findByGroupId" resultMap="GroupDocumentResultMap">
        SELECT * FROM group_document 
        WHERE group_id = #{groupId} AND status = 1
        ORDER BY create_time DESC
    </select>

    <select id="findByFolderId" resultMap="GroupDocumentResultMap">
        SELECT * FROM group_document 
        WHERE folder_id = #{folderId} AND status = 1
        ORDER BY create_time DESC
    </select>

    <select id="countByFolderId" resultType="int">
        SELECT COUNT(*) FROM group_document 
        WHERE folder_id = #{folderId} AND status = 1
    </select>

    <update id="incrementDownloadCount">
        UPDATE group_document 
        SET download_count = download_count + 1 
        WHERE document_id = #{documentId}
    </update>

</mapper>

